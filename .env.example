# =============================================================================
# Firebase Server & Cloud Functions Environment Configuration
# Govindasamy & Co / Surya Tex - Backend Server
# =============================================================================
# Copy this file to .env in this directory (surya-tex-server/.env)
# Fill in your new Firebase project credentials from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
# =============================================================================

# 1. Firebase Web / Client SDK Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# 2. Store Administrator Email
# Used by set_admin_claim.js to grant { admin: true } custom claims
ADMIN_EMAIL=your_admin_email@example.com

# 3. Server Runtime & Port Settings
PORT=10000

# 4. Connected Portals (Optional - Used for telemetry dashboard navigation links)
CLIENT_USER_URL=https://your-user-portal.web.app
CLIENT_OWNER_URL=https://your-owner-portal.web.app
SERVER_URL=https://your-server.onrender.com
